CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_HALOW_MESH_DEBUG_LOG=y
CONFIG_HALOW_RF_DEBUG_LOG=y
CONFIG_HALOW_MAC_DEBUG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
# CONFIG_LOG_MAXIMUM_LEVEL_DEBUG is not set
CONFIG_HALOW_MESH_ID="edgez"
CONFIG_HALOW_MESH_PASSPHRASE="edgez123"
CONFIG_HALOW_MESH_FREQUENCY_KHZ=915000
CONFIG_HALOW_MESH_BANDWIDTH_MHZ=2
CONFIG_HALOW_COUNTRY_CODE="US"
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"
CONFIG_DAB_START_MQTT_RELAY=y
CONFIG_DAB_WIFI_EXTENDER=n
CONFIG_HALOW_PAWR_ENABLE=y
CONFIG_DAB_FACTORY_RESET_BUTTON=y
CONFIG_DAB_FACTORY_RESET_BUTTON_GPIO=0
CONFIG_DAB_FACTORY_RESET_BUTTON_ACTIVE_LOW=y
