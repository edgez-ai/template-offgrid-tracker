/*
 * Seeed XIAO nRF54L15 Sense with the Seeed FGH100M HaLow shield.
 *
 * XIAO board pins:
 *   USER_LED -> P2.00, active-low
 *   USER_KEY -> P0.00, active-low with pull-up
 *   IMU_SDA  -> P0.04 (TWIM30 SDA)
 *   IMU_SCL  -> P0.03 (TWIM30 SCL)
 *   GPS_RXD  -> D6 / P2.08 (disabled in this logging build)
 *   GPS_TXD  -> D7 / P2.07 (disabled in this logging build)
 *
 * The board DTS already defines the LED, key, onboard LSM6DS3TR-C, and their
 * pinctrl entries. This overlay only adds the application aliases and the
 * external peripherals.
 */

/ {
	aliases {
		/delete-property/ gps0;
	};

	zephyr,user {
		key-gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		/* The Seeed FGH100M shield has no software-controlled power rail. */
		halow-always-powered;
		/* The onboard 1:1 VBAT divider is routed to SAADC AIN7/P1.14. */
		io-channels = <&adc 7>;
		io-channel-names = "battery";
	};
};

/* Enable the TPS22916-fed divider only while taking a battery sample. */
&vbat_pwr {
	/delete-property/ regulator-boot-on;
};

/* Reserve UART20 for the onboard debugger's PlatformIO VCOM console. */
&uart20 {
	status = "okay";
};

&xiao_serial {
	status = "disabled";
};

&lsm6ds3tr_c {
	status = "okay";
	zephyr,deferred-init;
};

/*
 * Seeed FGH100M shield:
 *   D3  -> P1.07 (CS)
 *   D8  -> P2.01 (SCK)
 *   D9  -> P2.04 (MISO)
 *   D10 -> P2.02 (MOSI)
 *   D2  -> P1.06 (IRQ)
 *   D4  -> P1.10 (BUSY)
 *   D1  -> P1.05 (WAKE)
 *   D0  -> P1.04 (RESETn)
 */
&xiao_spi {
	status = "okay";
	cs-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;

	morse_wifi: morse@0 {
		status = "okay";
		compatible = "morsemicro,mm6108";
		bcf = "bcf_fgh100mhaamd.mbin";
		/* nRF54L SPIM00 requires an exact even clock prescaler; 12 MHz is invalid. */
		spi-max-frequency = <8000000>;
		reg = <0>;

		spi-irq-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;
		busy-gpios = <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		wakeup-gpios = <&xiao_d 1 GPIO_ACTIVE_HIGH>;
		resetn-gpios = <&xiao_d 0 GPIO_ACTIVE_LOW>;
		/* The shield is always powered; it has no power-enable GPIO. */
	};
};
