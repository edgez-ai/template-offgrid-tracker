config MBEDTLS_ZEPHYR_ENTROPY
	bool

source "Kconfig.zephyr"

config WIFI_SSID
    string "Wi-Fi SSID of the AP we want to connect to"
    default "MorseMicro"

config WIFI_PSK
    string "Password of the AP we want to connect to"
    default "12345678"

config MQTT_BROKER_ADDR
    string "Address the MQTT broker is running on"
    default "192.168.12.1"

config MQTT_BROKER_PORT
    int "Port the MQTT broker is running on"
    default 1883

choice OFFGRID_NRF54_ROLE
    prompt "Offgrid Tracker nRF54L15 application role"
    default OFFGRID_NRF54_ROLE_COMPANION

config OFFGRID_NRF54_ROLE_COMPANION
    bool "BLE companion and full mesh node"
    help
      Build the phone companion role with BLE provisioning/realtime control,
      mesh peering, BATMAN forwarding, and normal user/device beacons.

config OFFGRID_NRF54_ROLE_SENSOR
    bool "Low-power connectionless HaLow sensor"
    help
      Build a dedicated sensor role. Bluetooth is not required, mesh peering
      and BATMAN are never started, and reports use the connectionless HaLow
      PAwR-like path.

endchoice

config OFFGRID_NRF54_SENSOR_BOOTSTRAP_COUNTRY
    string "Zero-touch sensor bootstrap country"
    default "US"
    help
      Regulatory domain used before a sensor has a provisioned profile.

config OFFGRID_NRF54_SENSOR_BOOTSTRAP_CHANNEL
    int "Zero-touch sensor bootstrap S1G channel"
    range 1 255
    default 27
    help
      Country-specific 802.11ah channel used for zero-touch requests before
      the accepted profile has been saved to normal settings storage.

config OFFGRID_NRF54_SENSOR_BOOTSTRAP_INTERVAL_SECONDS
    int "Zero-touch request interval"
    range 5 3600
    default 15
    help
      Time between connectionless HaLow provisioning requests.

config OFFGRID_NRF54_MESH_PS_TEST
    bool "Run the nRF54L15 mesh power-save experiment after peering"
    depends on WIFI_MORSEMICRO_EDGEZ_JOIN_ONLY
    depends on WIFI_MORSEMICRO_POWERSAVE
    default n
    help
      Wait for an established 802.11s peer, sample a power-save-off
      baseline, then enable MM6108 dynamic power saving and report MM_BUSY
      duty while the mesh runtime continues to run.

config OFFGRID_NRF54_IMU_ACCEL_ONLY
    bool "Use accelerometer-only low-power IMU FIFO sampling"
    default n
    help
      Keep the gyroscope powered down and collect only accelerometer samples
      through the IMU hardware FIFO. Intended for battery-powered sensors.

config OFFGRID_NRF54_IMU_TIMER_DRAIN
    bool "Drain the IMU FIFO only on the reporting timer wake"
    depends on OFFGRID_NRF54_IMU_ACCEL_ONLY
    default n
    help
      Do not route the FIFO watermark to an MCU interrupt and do not schedule
      periodic FIFO work. The sensor continues batching accelerometer samples
      in hardware while the MCU remains in System ON idle; the application
      drains the FIFO synchronously after the reporting timer wakes it.

config OFFGRID_NRF54_SENSOR_GPS
    bool "Wake GPS during each low-power sensor reporting cycle"
    default n
    help
      Wake the L76K and wait briefly for a fix before each sensor PAwR report,
      then stop GPS and suspend its UART before returning to tickless sleep.

config OFFGRID_NRF54_SENSOR_HALOW_POWER_SAVE
    bool "Keep HaLow initialized in chip sleep between sensor reports"
    depends on OFFGRID_NRF54_IMU_TIMER_DRAIN
    depends on WIFI_MORSEMICRO_POWERSAVE
    default n
    help
      Boot the MM8108 and initialize its connectionless PAwR radio once, then
      configure chip sleep once, then release the host wake veto between
      reports. CONFIG_PS is not toggled during recurring wake/transmit/sleep
      cycles, avoiding the associated-station transition overhead. The HaLow
      rail and SPI remain enabled, so compare average energy and wake latency
      against full rail cutoff rather than expecting the lowest sleep current.
