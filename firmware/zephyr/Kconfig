config MBEDTLS_ZEPHYR_ENTROPY
	bool

source "Kconfig.zephyr"

config WIFI_SSID
    string "Wi-Fi SSID of the AP we want to connect to"
    default "MorseMicro"

config WIFI_PSK
    string "Password of the AP we want to connect to"
    default "12345678"

config MQTT_BROKER_ADDR
    string "Address the MQTT broker is running on"
    default "192.168.12.1"

config MQTT_BROKER_PORT
    int "Port the MQTT broker is running on"
    default 1883

config OFFGRID_NRF54_MESH_PS_TEST
    bool "Run the nRF54L15 mesh power-save experiment after peering"
    depends on WIFI_MORSEMICRO_EDGEZ_JOIN_ONLY
    depends on WIFI_MORSEMICRO_POWERSAVE
    default n
    help
      Wait for an established 802.11s peer, sample a power-save-off
      baseline, then enable MM6108 dynamic power saving and report MM_BUSY
      duty while the mesh runtime continues to run.

config OFFGRID_NRF54_IMU_ACCEL_ONLY
    bool "Use accelerometer-only low-power IMU FIFO sampling"
    default n
    help
      Keep the gyroscope powered down and collect only accelerometer samples
      through the IMU hardware FIFO. Intended for battery-powered sensors.

config OFFGRID_NRF54_IMU_TIMER_DRAIN
    bool "Drain the IMU FIFO only on the reporting timer wake"
    depends on OFFGRID_NRF54_IMU_ACCEL_ONLY
    default n
    help
      Do not route the FIFO watermark to an MCU interrupt and do not schedule
      periodic FIFO work. The sensor continues batching accelerometer samples
      in hardware while the MCU remains in System ON idle; the application
      drains the FIFO synchronously after the reporting timer wakes it.

config OFFGRID_NRF54_SENSOR_GPS
    bool "Wake GPS during each low-power sensor reporting cycle"
    default n
    help
      Wake the L76K and wait briefly for a fix before each sensor PAwR report,
      then stop GPS and suspend its UART before returning to tickless sleep.
