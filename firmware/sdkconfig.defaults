CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_SPIRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=32768
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_HALOW_MESH_MODE=y
CONFIG_HALOW_MESH_PREQ_INTERVAL_MS=4000
CONFIG_HALOW_EDGEZ_BATMAN=y
CONFIG_HALOW_EDGEZ_MQTT_RELAY=n
CONFIG_DAB_START_BATMAN=y
CONFIG_DAB_START_MQTT_RELAY=n
CONFIG_DAB_WIFI_EXTENDER=y
CONFIG_DAB_MESH_IPERF=y
CONFIG_DAB_PUBLISH_SYSTEM_STATUS=y
CONFIG_HALOW_EDGEZ_MEMORY_DIAGNOSTICS=n
CONFIG_HEAP_POISONING_LIGHT=y
CONFIG_HALOW_EDGEZ_BATMAN_INTERVAL_MS=1000
CONFIG_HALOW_USB_DEBUG_LOG=n
CONFIG_HALOW_RF_DEBUG_LOG=n
CONFIG_HALOW_MAC_DEBUG_LOG=n
CONFIG_HALOW_MESH_DEBUG_LOG=n
CONFIG_HALOW_MESH_AUTO_JOIN=y
CONFIG_HALOW_MESH_SCAN_DWELL_MS=120
CONFIG_HALOW_MESH_SCAN_INTERVAL_BASE_S=1
CONFIG_HALOW_MESH_SCAN_INTERVAL_LIMIT_S=8
CONFIG_HALOW_MESH_ID="halow-mesh"
CONFIG_HALOW_MESH_PASSPHRASE="12345678"
CONFIG_HALOW_MESH_FREQUENCY_KHZ=0
CONFIG_HALOW_MESH_BANDWIDTH_MHZ=0
CONFIG_HALOW_COUNTRY_CODE="EU"
CONFIG_HALOW_PS_MODE=n
CONFIG_MBEDTLS_CMAC_C=y
