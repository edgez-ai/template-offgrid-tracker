CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Internal PAwR ESP32-S3 board: MM6108 over SDIO/SPI.
CONFIG_HALOW_TRANSPORT_SPI=y
CONFIG_MM_CHIP_MM6108=y
CONFIG_MM_BCF_FILE="bcf_mf08551.mbin"
CONFIG_MM_RESET_N=8
CONFIG_MM_WAKE=9
CONFIG_MM_BUSY=7
CONFIG_MM_SPI_SCK=4
CONFIG_MM_SPI_MOSI=3
CONFIG_MM_SPI_MISO=5
CONFIG_MM_SPI_CS=2
CONFIG_MM_SPI_IRQ=6

# The newer Morse stack retains more packets while the MM8108 drains a burst.
# Keep the v2 control/priority reservations, but use its earlier proven 48-slot
# ceiling so the resulting bulk limit is 40 rather than only 12 packets.
CONFIG_MMPKTMEM_TX_POOL_N_BLOCKS=48
CONFIG_MMPKTMEM_RX_POOL_N_BLOCKS=64

CONFIG_HALOW_PAWR_ENABLE=y
CONFIG_HALOW_BLE_PROVISIONING=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
