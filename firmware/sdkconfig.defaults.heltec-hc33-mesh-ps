# Heltec HT-HC33 (ESP32-S3 + MM6108) mesh power-save test.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_HALOW_MESH_ID="edgez"
CONFIG_HALOW_MESH_PASSPHRASE="edgez123"
CONFIG_HALOW_MESH_FREQUENCY_KHZ=915000
CONFIG_HALOW_MESH_BANDWIDTH_MHZ=2
CONFIG_HALOW_COUNTRY_CODE="US"
CONFIG_MM_BCF_FILE="bcf_fgh100mhaamd.mbin"

CONFIG_OFFGRID_MESH_PS_TEST=y
CONFIG_OFFGRID_MESH_PS_VIF_ID=0
CONFIG_HALOW_PS_MODE=y

# app_main initializes only the BATMAN receive worker for this test, at its
# longest interval, because peers can still send routing frames.
CONFIG_DAB_START_BATMAN=n
CONFIG_DAB_START_MQTT_RELAY=n
CONFIG_HALOW_EDGEZ_BATMAN=n
CONFIG_HALOW_EDGEZ_MQTT_RELAY=n
CONFIG_DAB_WIFI_EXTENDER=n
CONFIG_DAB_MESH_IPERF=n
CONFIG_DAB_PUBLISH_SYSTEM_STATUS=n
CONFIG_HALOW_PAWR_ENABLE=n
CONFIG_HALOW_BLE_PROVISIONING=n
CONFIG_HALOW_MESH_DEBUG_LOG=y
