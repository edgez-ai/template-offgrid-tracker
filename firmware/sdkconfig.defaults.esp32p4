CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP32P4_REV_MIN_FULL=301
CONFIG_ESP32P4_REV_MAX_FULL=399

CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# HaLow has a materially larger RTT than local Ethernet/Wi-Fi.  Keep enough
# TCP data in flight to feed the 2 MHz link and the Block Ack aggregation
# window instead of stalling after the lwIP default four-segment window.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=2
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=131072
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=12
CONFIG_LWIP_TCP_SACK_OUT=y

# Keep compute-heavy crypto on the ESP32-P4 accelerators. Mesh CCMP uses the
# AES backend below; SAE/TLS additionally benefit from SHA, MPI and ECC.
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_AES_USE_INTERRUPT=y
CONFIG_MBEDTLS_HARDWARE_GCM=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_MPI_USE_INTERRUPT=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_ECC=y
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=y

# Match the proven v2 extender budget. Keeping the TX window bounded prevents
# a bulk transfer from consuming internal SRAM needed by MQTT/Alfred/control.
CONFIG_MMPKTMEM_TX_POOL_N_BLOCKS=20
CONFIG_MMPKTMEM_RX_POOL_N_BLOCKS=64

# P4 extender is forwarding-only. Leave MQTT relay and periodic telemetry off
# so their packet bursts cannot compete with routed traffic for Morse buffers.
# CONFIG_HALOW_EDGEZ_MQTT_RELAY is not set
# CONFIG_DAB_START_MQTT_RELAY is not set
# CONFIG_DAB_PUBLISH_SYSTEM_STATUS is not set
CONFIG_HALOW_EDGEZ_BATMAN_INTERVAL_MS=1000

CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
# Keep DWC descriptors and USB transfer buffers in DMA-capable internal RAM.
# External PSRAM can leave the MM8108's first EP0 transaction pending on P4.
# CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM is not set
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Waveshare ESP32-P4 with MM8108 on the high-speed USB host.
CONFIG_HALOW_TRANSPORT_USB=y
CONFIG_HALOW_USB_DEBUG_LOG=y
CONFIG_HALOW_MESH_DEBUG_LOG=y
CONFIG_MM_BCF_FILE="bcf_mf15457.mbin"
CONFIG_MM_CHIP_MM8108=y
CONFIG_HALOW_PAWR_ENABLE=y
CONFIG_HALOW_MESH_ID="edgez"
CONFIG_HALOW_MESH_PASSPHRASE="edgez123"
CONFIG_HALOW_COUNTRY_CODE="US"
CONFIG_HALOW_MESH_FREQUENCY_KHZ=915000
CONFIG_HALOW_MESH_BANDWIDTH_MHZ=2

# Waveshare ESP32-P4-WIFI6-DEV-KIT BOOT button. GPIO35 is active low and is
# shared with Ethernet RMII TXD1, so onboard Ethernet must remain disabled.
CONFIG_DAB_FACTORY_RESET_BUTTON=y
CONFIG_DAB_FACTORY_RESET_BUTTON_GPIO=35
CONFIG_DAB_FACTORY_RESET_BUTTON_ACTIVE_LOW=y
CONFIG_DAB_FACTORY_RESET_BUTTON_HOLD_MS=5000

# Match ESP32-S3: advertise the FFF0 realtime control service through the
# onboard ESP32-C6 and wait for INIT_HALOW before starting the mesh.
CONFIG_HALOW_BLE_PROVISIONING=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
