CONFIG_OFFGRID_PAWR_BULK_TEST_RECEIVER=y
CONFIG_HALOW_PAWR_ENABLE=y
CONFIG_HALOW_COUNTRY_CODE="EU"
CONFIG_HALOW_MESH_FREQUENCY_KHZ=863500
CONFIG_HALOW_MESH_BANDWIDTH_MHZ=1

# The receiver is a radio diagnostic, so it starts from the fixed profile
# without waiting for BLE provisioning.
CONFIG_HALOW_BLE_PROVISIONING=n
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=n
CONFIG_DAB_START_BATMAN=n
CONFIG_DAB_WIFI_EXTENDER=n
CONFIG_DAB_START_NETWORK_PACKET_RELAY=n
CONFIG_DAB_START_MQTT_RELAY=n

# Keep the console concise enough that it cannot starve the PAwR worker.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
